{
  "$defs": {
    "common": {
      "$defs": {
        "AttachmentRef": {
          "$comment": "Request-local token only; name must resolve uniquely and normalize to a bytes: ref before final validation/signing.",
          "pattern": "^attachment:[^\\s]+$",
          "type": "string"
        },
        "Base64": {
          "$comment": "Canonical pad bits and decoded content require semantic checking.",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "type": "string"
        },
        "BytesRef": {
          "pattern": "^bytes:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "Digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "EventRef": {
          "pattern": "^event:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "EvidenceRef": {
          "pattern": "^evidence:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "ExactRef": {
          "pattern": "^(?:evidence|bytes|event):sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "Frontier": {
          "$comment": "Sort by stream ID; exactly one head per stream. JSON Schema cannot enforce uniqueness by stream or cross-record agreement.",
          "items": {
            "$ref": "#/$defs/common/$defs/FrontierEntry"
          },
          "type": "array",
          "uniqueItems": true
        },
        "FrontierEntry": {
          "additionalProperties": false,
          "properties": {
            "event": {
              "$ref": "#/$defs/common/$defs/EvidenceRef"
            },
            "seq": {
              "$ref": "#/$defs/common/$defs/Position"
            },
            "stream": {
              "$ref": "#/$defs/common/$defs/IdentityURI"
            }
          },
          "required": [
            "stream",
            "seq",
            "event"
          ],
          "type": "object"
        },
        "IdentityURI": {
          "$comment": "The selected profile declares which stable URI schemes/identities it accepts; syntax is not authentication.",
          "format": "uri",
          "pattern": "^(?!evidence:|bytes:|event:|attachment:)[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "JSONValue": {
          "$comment": "Core additionally rejects lexical floating-point numbers, duplicate keys and invalid Unicode; ordinary JSON Schema operates on already parsed values.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/common/$defs/JSONValue"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/common/$defs/JSONValue"
              },
              "type": "object"
            }
          ]
        },
        "KeyID": {
          "pattern": "^key:[a-z0-9-]+:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "Position": {
          "minimum": 1,
          "type": "integer"
        },
        "ResponseOutcome": {
          "enum": [
            "completed",
            "failed",
            "denied",
            "cancelled",
            "partial",
            "unknown"
          ]
        },
        "SessionOutcome": {
          "enum": [
            "completed",
            "interrupted",
            "failed",
            "unknown"
          ]
        },
        "Timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "UTCTimestamp": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        }
      },
      "title": "Provenance v2 common values"
    },
    "signed_evidence": {
      "$comment": "The payload decodes to exact Core canonical Evidence bytes. One to sixteen signatures over the same message. The first keyid must equal payload.issuer, no keyid may repeat, and every signature must verify. How many a kind needs is stated by its definition. Neither decoding nor cryptographic checks are performed by JSON Schema.",
      "additionalProperties": false,
      "properties": {
        "payload": {
          "$ref": "#/$defs/common/$defs/Base64",
          "minLength": 1
        },
        "payloadType": {
          "const": "application/vnd.r5e.provenance-evidence+json;v=2"
        },
        "signatures": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "keyid": {
                "$ref": "#/$defs/common/$defs/KeyID"
              },
              "sig": {
                "$ref": "#/$defs/common/$defs/Base64",
                "minLength": 1
              }
            },
            "required": [
              "keyid",
              "sig"
            ],
            "type": "object"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "payloadType",
        "payload",
        "signatures"
      ],
      "title": "Provenance v2 SignedEvidence DSSE envelope",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$comment": "Transport shape for scoped offline verification inputs. Does not verify digests, signatures, keys, profiles, authorization, completeness, proofs or omissions. Records contain only v2 SignedEvidence; v1 bytes may be attachments and require an explicit separate reader.",
      "additionalProperties": false,
      "properties": {
        "blobs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "base64": {
                "$ref": "#/$defs/common/$defs/Base64"
              },
              "mediaType": {
                "type": "string"
              },
              "ref": {
                "$ref": "#/$defs/common/$defs/BytesRef"
              }
            },
            "required": [
              "ref",
              "base64"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "checkpoints": {
          "items": {
            "$ref": "#/$defs/common/$defs/EvidenceRef"
          },
          "type": "array"
        },
        "format": {
          "const": "r5e.provenance-export/v2"
        },
        "keys": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "algorithm": {
                "enum": [
                  "ed25519",
                  "es256",
                  "es384"
                ]
              },
              "bytes": {
                "$ref": "#/$defs/common/$defs/Base64"
              },
              "keyid": {
                "$ref": "#/$defs/common/$defs/KeyID"
              }
            },
            "required": [
              "keyid",
              "algorithm",
              "bytes"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "omissions": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "detail": {
                "type": "string"
              },
              "reason": {
                "enum": [
                  "unavailable",
                  "withheld",
                  "expired",
                  "not-selected",
                  "unsupported"
                ]
              },
              "ref": {
                "$ref": "#/$defs/common/$defs/ExactRef"
              }
            },
            "required": [
              "ref",
              "reason"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "proofs": {
          "items": {
            "$comment": "index is zero-based. The named record must match the seal stream and position firstSeq + index; proof length, leaf and tree shape require semantic verification.",
            "additionalProperties": false,
            "properties": {
              "index": {
                "minimum": 0,
                "type": "integer"
              },
              "record": {
                "$ref": "#/$defs/common/$defs/EvidenceRef"
              },
              "seal": {
                "$ref": "#/$defs/common/$defs/EvidenceRef"
              },
              "siblings": {
                "items": {
                  "$ref": "#/$defs/common/$defs/Digest"
                },
                "type": "array"
              }
            },
            "required": [
              "record",
              "seal",
              "index",
              "siblings"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "publicationProofs": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "commitment": {
                "$ref": "#/$defs/common/$defs/EvidenceRef"
              },
              "proofRef": {
                "$ref": "#/$defs/common/$defs/BytesRef"
              },
              "targetProfileRef": {
                "$ref": "#/$defs/common/$defs/BytesRef"
              }
            },
            "required": [
              "targetProfileRef",
              "commitment",
              "proofRef"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "records": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "envelope": {
                "$ref": "#/$defs/signed_evidence"
              },
              "ref": {
                "$ref": "#/$defs/common/$defs/EvidenceRef"
              }
            },
            "required": [
              "ref",
              "envelope"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "scope": {
          "additionalProperties": false,
          "properties": {
            "at": {
              "$ref": "#/$defs/common/$defs/Frontier"
            },
            "query": {
              "$ref": "#/$defs/common/$defs/JSONValue"
            }
          },
          "required": [
            "query",
            "at"
          ],
          "type": "object"
        },
        "seals": {
          "items": {
            "$ref": "#/$defs/common/$defs/EvidenceRef"
          },
          "type": "array"
        }
      },
      "required": [
        "format",
        "scope",
        "records",
        "blobs",
        "keys",
        "seals",
        "checkpoints",
        "proofs",
        "publicationProofs",
        "omissions"
      ],
      "title": "Provenance v2 Export",
      "type": "object"
    }
  ]
}