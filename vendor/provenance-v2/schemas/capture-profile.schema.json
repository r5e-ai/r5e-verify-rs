{
  "$defs": {
    "common": {
      "$defs": {
        "AttachmentRef": {
          "$comment": "Request-local token only; name must resolve uniquely and normalize to a bytes: ref before final validation/signing.",
          "pattern": "^attachment:[^\\s]+$",
          "type": "string"
        },
        "Base64": {
          "$comment": "Canonical pad bits and decoded content require semantic checking.",
          "contentEncoding": "base64",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
          "type": "string"
        },
        "BytesRef": {
          "pattern": "^bytes:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "Digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "EventRef": {
          "pattern": "^event:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "EvidenceRef": {
          "pattern": "^evidence:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "ExactRef": {
          "pattern": "^(?:evidence|bytes|event):sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "Frontier": {
          "$comment": "Sort by stream ID; exactly one head per stream. JSON Schema cannot enforce uniqueness by stream or cross-record agreement.",
          "items": {
            "$ref": "#/$defs/common/$defs/FrontierEntry"
          },
          "type": "array",
          "uniqueItems": true
        },
        "FrontierEntry": {
          "additionalProperties": false,
          "properties": {
            "event": {
              "$ref": "#/$defs/common/$defs/EvidenceRef"
            },
            "seq": {
              "$ref": "#/$defs/common/$defs/Position"
            },
            "stream": {
              "$ref": "#/$defs/common/$defs/IdentityURI"
            }
          },
          "required": [
            "stream",
            "seq",
            "event"
          ],
          "type": "object"
        },
        "IdentityURI": {
          "$comment": "The selected profile declares which stable URI schemes/identities it accepts; syntax is not authentication.",
          "format": "uri",
          "pattern": "^(?!evidence:|bytes:|event:|attachment:)[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$",
          "type": "string"
        },
        "JSONValue": {
          "$comment": "Core additionally rejects lexical floating-point numbers, duplicate keys and invalid Unicode; ordinary JSON Schema operates on already parsed values.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/common/$defs/JSONValue"
              },
              "type": "array"
            },
            {
              "additionalProperties": {
                "$ref": "#/$defs/common/$defs/JSONValue"
              },
              "type": "object"
            }
          ]
        },
        "KeyID": {
          "pattern": "^key:[a-z0-9-]+:sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "Position": {
          "minimum": 1,
          "type": "integer"
        },
        "ResponseOutcome": {
          "enum": [
            "completed",
            "failed",
            "denied",
            "cancelled",
            "partial",
            "unknown"
          ]
        },
        "SessionOutcome": {
          "enum": [
            "completed",
            "interrupted",
            "failed",
            "unknown"
          ]
        },
        "Timestamp": {
          "format": "date-time",
          "type": "string"
        },
        "UTCTimestamp": {
          "format": "date-time",
          "pattern": "Z$",
          "type": "string"
        }
      },
      "title": "Provenance v2 common values"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$comment": "Finite schema and authority declarations. Prefix matching, grant union, trusted active profile selection, policy narrowing and persistence guarantees require semantic checks; profile trust is external.",
      "additionalProperties": false,
      "properties": {
        "authority": {
          "additionalProperties": false,
          "properties": {
            "bindings": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "actorPrefixes": {
                    "items": {
                      "$ref": "#/$defs/common/$defs/IdentityURI"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "issuerKeys": {
                    "items": {
                      "$ref": "#/$defs/common/$defs/KeyID"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "sealerKeys": {
                    "items": {
                      "$ref": "#/$defs/common/$defs/KeyID"
                    },
                    "type": "array"
                  },
                  "streamPrefix": {
                    "$ref": "#/$defs/common/$defs/IdentityURI"
                  }
                },
                "required": [
                  "streamPrefix",
                  "actorPrefixes",
                  "issuerKeys",
                  "sealerKeys"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "checkpointKeys": {
              "items": {
                "$ref": "#/$defs/common/$defs/KeyID"
              },
              "type": "array"
            }
          },
          "required": [
            "bindings",
            "checkpointKeys"
          ],
          "type": "object"
        },
        "deploymentPolicyRef": {
          "$ref": "#/$defs/common/$defs/BytesRef"
        },
        "durability": {
          "additionalProperties": false,
          "properties": {
            "failureDomain": {
              "minLength": 1,
              "type": "string"
            },
            "onFailure": {
              "enum": [
                "refuse",
                "pending"
              ]
            },
            "requiredPayloads": {
              "enum": [
                "submitted",
                "submitted-and-policy-inputs"
              ]
            }
          },
          "required": [
            "failureDomain",
            "requiredPayloads",
            "onFailure"
          ],
          "type": "object"
        },
        "format": {
          "const": "r5e.capture-profile/v2"
        },
        "policyRequiredKinds": {
          "$comment": "Every listed kind requires inline body.policy conforming to PolicyEvaluation under the active profile. A later separately recorded PolicyDecision does not satisfy this requirement.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "retention": {
          "$comment": "How long the content of records made under this profile must be kept, fixed when the record is made. Leaving it out means the content is never disposed of.",
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "disposal": {
                  "const": "never"
                }
              },
              "required": [
                "disposal"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "disposal": {
                  "const": "by-record"
                },
                "keepContentForSeconds": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "disposal",
                "keepContentForSeconds"
              ],
              "type": "object"
            }
          ]
        },
        "schemas": {
          "additionalProperties": {
            "$ref": "#/$defs/common/$defs/BytesRef"
          },
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1,
            "type": "string"
          },
          "type": "object"
        }
      },
      "required": [
        "format",
        "schemas",
        "authority",
        "durability",
        "policyRequiredKinds",
        "deploymentPolicyRef"
      ],
      "title": "Provenance v2 CaptureProfile",
      "type": "object"
    }
  ]
}